<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Custom Metrics Ruleset"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/pmd-6.55.0/ruleset_2_0_0.xsd">

  <description>Custom rules for metrics: LoC, CC, WMC, CBO, LCOM</description>

  <!-- Lines of Code (LoC) -->
  <rule ref="category/java/design.xml/ExcessiveClassLength"/>
  <rule ref="category/java/design.xml/ExcessiveMethodLength"/>

  <!-- Cyclomatic Complexity (CC) -->
  <rule ref="category/java/design.xml/CyclomaticComplexity"/>

  <!-- Weighted Methods per Class (WMC) -->
  <rule ref="category/java/design.xml/TooManyMethods"/>

  <!-- Coupling Between Objects (CBO) -->
  <rule ref="category/java/design.xml/CouplingBetweenObjects"/>

  <!-- Lack of Cohesion in Methods (LCOM)-->
  <rule ref="category/java/design.xml/TooManyFields"/>
  <rule ref="category/java/design.xml/LawOfDemeter"/>

</ruleset>